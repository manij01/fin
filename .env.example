# Optional: OpenAI API key for live LLM chat functionality
# If not set, the built-in deterministic demo chat is used.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI model used by LiteLLM for live chat
OPENAI_MODEL=gpt-4o-mini

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: SQLite path for local development.
# Docker sets this to /app/db/finally.db automatically.
# DB_PATH=db/finally.db
